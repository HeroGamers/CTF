  [...new Uint8Array(new Uint32Array([(s=>{for(var t=0^(-1),i=0;i<s.length;i++){var c=s.charCodeAt(i);t=(t>>>8)^((()=>{var r=0,e;for(var j=0;j<256;j++){r=j;for(e=0;e<8;e++)r=(1&r)?(r>>>1)^3988292384:r>>>1}return arguments.callee.tbl||(arguments.callee.tbl=Array.from({length:256},(_,j)=>{var r=j,e;for(e=0;e<8;e++)r=(1&r)?(r>>>1)^3988292384:r>>>1;return r}))})()[255&(t^c)])}return(t^(-1))>>>0})(Deno.args[0])]).buffer)].reverse().map(b=>b.toString(16).padStart(2,'0')).join``)
